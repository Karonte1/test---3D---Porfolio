---
// Página con imagen central grande (fondo transparente con mix-blend-mode) + 6 charms individuales en cascada infinita
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>LARI.DESIGN — Portfolio 3D</title>
    <style>
      :root {
        --color-bg: #dad5db;
        --color-pink: #ff2a85;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background-color: var(--color-bg);
        color: #1a1a1a;
        font-family: monospace;
        overflow-x: hidden;
      }

      #canvas-container {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        z-index: 0;
        pointer-events: none;
      }

      .content-wrapper {
        position: relative;
        z-index: 10;
        max-width: 1200px;
        margin: 0 auto;
        padding: 60px 40px;
      }

      header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid rgba(0,0,0,0.1);
        padding-bottom: 20px;
        margin-bottom: 80px;
      }

      .logo {
        font-weight: bold;
        font-size: 1.2rem;
        letter-spacing: -0.05em;
      }

      .hero {
        height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center; /* Centrar elementos visuales */
        text-align: center;
      }

   .central-image-container {
        margin-bottom: 30px;
        background: transparent; 
        box-shadow: none; 
        padding: 0;
      }

      .central-image-container img {
        max-width: 1000px;
        width: 100%;
        height: auto;
        display: block;
        /* Ya no necesitamos mix-blend-mode porque el PNG es transparente por sí mismo */
      }

      h1 {
        font-size: clamp(2.5rem, 6vw, 5rem);
        line-height: 0.95;
        text-transform: uppercase;
        margin: 0 0 20px 0;
        font-weight: 900;
        
        backdrop-filter: blur(4px);
        padding: 10px;
        border-radius: 4px;
      }

      h1 span {
        color: var(--color-pink);
      }

      p.bio {
        max-width: 450px;
        font-size: 0.95rem;
        line-height: 1.6;
        color: #444;
        background-color: rgba(244, 236, 247, 0.7);
        backdrop-filter: blur(4px);
        padding: 10px;
        border-radius: 4px;
      }

      .section-projects {
        padding-top: 150px;
        min-height: 100vh;
      }

      .project-card {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(0,0,0,0.08);
        padding: 30px;
        margin-bottom: 30px;
        border-radius: 4px;
        box-shadow: 0 20px 40px -15px rgba(0,0,0,0.05);
      }
    </style>
  </head>
  <body>

    <!-- Contenedor exclusivo para los charms 3D flotantes -->
    <div id="canvas-container"></div>

    <div class="content-wrapper">
      <header>
        <div class="logo">LARI.DESIGN // 2026</div>
        <div>[ BCN / EXPERIMENTAL ]</div>
      </header>

      <section class="hero">
        <!-- Imagen central grande con ruta segura para GitHub Pages y carpeta img -->
        <div class="central-image-container">
          <img src={`${import.meta.env.BASE_URL}img/hello3.png`} alt="Hello 3" />
        </div>

        <h1><br/><span></span></h1>
        <p class="">
         
        </p>
      </section>

      <section class="section-projects">
        <h3>// Proyectos Destacados</h3>
        <div class="project-card">
          <h4>REUNIMOS™</h4>
          <p>Los charms ya no molestan aquí.</p>
        </div>
      </section>
    </div>

    <script>
      import * as THREE from 'three';
      import { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js';

      const container = document.getElementById('canvas-container');
      const scene = new THREE.Scene();

      const camera = new THREE.PerspectiveCamera(40, window.innerWidth / window.innerHeight, 0.1, 1000);
      camera.position.set(0, 0, 9);

      const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
      renderer.setSize(window.innerWidth, window.innerHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      container.appendChild(renderer.domElement);

      const ambientLight = new THREE.AmbientLight(0xffffff, 1.8);
      scene.add(ambientLight);

      const directionalLight = new THREE.DirectionalLight(0xffffff, 2.5);
      directionalLight.position.set(5, 5, 5);
      scene.add(directionalLight);

      const loader = new GLTFLoader();
      
      interface FallingItem {
        mesh: THREE.Object3D;
        speedY: number;
        rotX: number;
        rotY: number;
        startX: number;
      }

      const fallingItems: FallingItem[] = [];
      const baseUrl = import.meta.env.BASE_URL;

      // CARGAR LOS 6 ARCHIVOS DE CHARMS INDIVIDUALMENTE CON RUTA ABSOLUTA
      const charmFiles = [
        'charms1.glb', 'charms2.glb', 'charms3.glb',
        'charms4.glb', 'charms5.glb', 'charms6.glb'
      ].map(file => `${baseUrl}${file}`); 

      charmFiles.forEach((file) => {
        loader.load(
          file,
          (gltf) => {
            const originalScene = gltf.scene;

            // Creamos 3 copias de cada archivo para saturar la pantalla
            for (let i = 0; i < 3; i++) {
              const clone = originalScene.clone(true);
              
              const scale = 1.5;
              clone.scale.set(scale, scale, scale);

              const randomX = (Math.random() - 0.5) * 36; 
              const randomY = Math.random() * 12 - 2;
              const randomZ = Math.random() * 2 - 1;

              clone.position.set(randomX, randomY, randomZ);
              clone.rotation.set(Math.random() * Math.PI, Math.random() * Math.PI, Math.random() * Math.PI);

              clone.traverse((subChild) => {
                if ((subChild as THREE.Mesh).isMesh) {
                  const mesh = subChild as THREE.Mesh;
                  if (mesh.material) {
                    mesh.material = (mesh.material as THREE.Material).clone();
                    const mat = mesh.material as THREE.MeshStandardMaterial;
                    mat.transparent = true;
                    mat.opacity = 1.0;
                    mat.needsUpdate = true;
                  }
                }
              });

              scene.add(clone);

              fallingItems.push({
                mesh: clone,
                speedY: 0.001 + Math.random() * 0.003,
                rotX: 0.001 + Math.random() * 0.003,
                rotY: 0.001 + Math.random() * 0.003,
                startX: randomX
              });
            }
          },
          undefined,
          (error) => { console.warn(`No se pudo cargar ${file}`, error); }
        );
      });

      // BUCLE DE ANIMACIÓN Y SCROLL DE LOS CHARMS
      function animate() {
        requestAnimationFrame(animate);

        const scrollY = window.scrollY;
        const fadeHeight = window.innerHeight * 0.8;
        let scrollProgress = 1 - (scrollY / fadeHeight);
        scrollProgress = Math.max(0, Math.min(1, scrollProgress));

        fallingItems.forEach((item) => {
          item.mesh.position.y -= item.speedY;

          if (item.mesh.position.y < -5) {
            item.mesh.position.y = 7 + Math.random() * 2;
            item.mesh.position.x = (Math.random() - 0.5) * 36;
          }

          item.mesh.rotation.x += item.rotX;
          item.mesh.rotation.y += item.rotY;

          item.mesh.traverse((child) => {
            if ((child as THREE.Mesh).isMesh) {
              const mesh = child as THREE.Mesh;
              const mats = Array.isArray(mesh.material) ? mesh.material : [mesh.material];
              mats.forEach(mat => mat.opacity = scrollProgress);
            }
          });
        });

        renderer.render(scene, camera);
      }
      animate();

      window.addEventListener('resize', () => {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
      });
    </script>
  </body>
</html>