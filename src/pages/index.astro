---
// Página con 'hola.glb' estático + 6 charms individuales ocupando toda la pantalla en cascada infinita
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>LARI.DESIGN — Portfolio 3D</title>
    <style>
      :root {
        --color-bg: #f4ecf7;
        --color-pink: #ff2a85;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background-color: var(--color-bg);
        color: #1a1a1a;
        font-family: monospace;
        overflow-x: hidden;
      }

      #canvas-container {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        z-index: 0;
        pointer-events: none;
      }

      .content-wrapper {
        position: relative;
        z-index: 10;
        max-width: 1200px;
        margin: 0 auto;
        padding: 60px 40px;
      }

      header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid rgba(0,0,0,0.1);
        padding-bottom: 20px;
        margin-bottom: 80px;
      }

      .logo {
        font-weight: bold;
        font-size: 1.2rem;
        letter-spacing: -0.05em;
      }

      .hero {
        height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }

      h1 {
        font-size: clamp(3rem, 7vw, 6rem);
        line-height: 0.95;
        text-transform: uppercase;
        margin: 0 0 20px 0;
        font-weight: 900;
        /* Fondo semitransparente para el texto si los iconos pasan por detrás */
        background-color: rgba(244, 236, 247, 0.6);
        backdrop-filter: blur(2px);
        padding: 10px;
        border-radius: 4px;
        display: inline-block;
      }

      h1 span {
        color: var(--color-pink);
      }

      p.bio {
        max-width: 450px;
        font-size: 0.95rem;
        line-height: 1.6;
        color: #444;
        background-color: rgba(244, 236, 247, 0.6);
        backdrop-filter: blur(2px);
        padding: 10px;
        border-radius: 4px;
        display: inline-block;
      }

      .section-projects {
        padding-top: 150px;
        min-height: 100vh;
      }

      .project-card {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(0,0,0,0.08);
        padding: 30px;
        margin-bottom: 30px;
        border-radius: 4px;
        box-shadow: 0 20px 40px -15px rgba(0,0,0,0.05);
      }
    </style>
  </head>
  <body>

    <div id="canvas-container"></div>

    <div class="content-wrapper">
      <header>
        <div class="logo">LARI.DESIGN // 2026</div>
        <div>[ BCN / EXPERIMENTAL ]</div>
      </header>

      <section class="hero">
        <h1>3D & <br/><span>Interactive</span></h1>
        <p class="bio">
          Los iconos ocupan todo el ancho de la pantalla en cascada infinita y se desvanecen al hacer scroll.
        </p>
      </section>

      <section class="section-projects">
        <h3>// Proyectos Destacados</h3>
        <div class="project-card">
          <h4>REUNIMOS™</h4>
          <p>Los charms ya no molestan aquí.</p>
        </div>
      </section>
    </div>

    <script>
      import * as THREE from 'three';
      import { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js';

      const container = document.getElementById('canvas-container');
      const scene = new THREE.Scene();

      const camera = new THREE.PerspectiveCamera(40, window.innerWidth / window.innerHeight, 0.1, 1000);
      camera.position.set(0, 0, 9);

      const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
      renderer.setSize(window.innerWidth, window.innerHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      container.appendChild(renderer.domElement);

      const ambientLight = new THREE.AmbientLight(0xffffff, 1.8);
      scene.add(ambientLight);

      const directionalLight = new THREE.DirectionalLight(0xffffff, 2.5);
      directionalLight.position.set(5, 5, 5);
      scene.add(directionalLight);

      const loader = new GLTFLoader();
      let holaModel: THREE.Group | null = null;
      
      interface FallingItem {
        mesh: THREE.Object3D;
        speedY: number;
        rotX: number;
        rotY: number;
        startX: number; // Guardamos la posición X inicial para un movimiento ligero
      }

      const fallingItems: FallingItem[] = [];

      // 1. CARGAR EL MODELO PRINCIPAL (HOLA)
      loader.load(
        '/hello2.glb',
        (gltf) => {
          holaModel = gltf.scene;
          const holaScale = 0.15; // Un poco más grande para que destaque
          holaModel.scale.set(holaScale, holaScale, holaScale);
          holaModel.position.set(0, 0, 0);

          holaModel.traverse((child) => {
            if ((child as THREE.Mesh).isMesh) {
              const mesh = child as THREE.Mesh;
              if (mesh.material) {
                const materials = Array.isArray(mesh.material) ? mesh.material : [mesh.material];
                materials.forEach((mat) => {
                  mat.transparent = true;
                  mat.opacity = 1.0;
                });
              }
            }
          });

          scene.add(holaModel);
        },
        undefined,
        (error) => { console.error('Error cargando hola.glb:', error); }
      );

      // 2. CARGAR LOS 6 ARCHIVOS DE CHARMS INDIVIDUALMENTE (A ESCALA GRANDE)
      const charmFiles = [
        '/charms1.glb', '/charms2.glb', '/charms3.glb',
        '/charms4.glb', '/charms5.glb', '/charms6.glb'
      ]; 

      charmFiles.forEach((file) => {
        loader.load(
          file,
          (gltf) => {
            const originalScene = gltf.scene;

            // Creamos 3 copias de cada archivo para saturar la pantalla
            for (let i = 0; i < 3; i++) {
              const clone = originalScene.clone(true);
              
              // --- CAMBIO CLAVE 1: ESCALA MUY GRANDE (Aprox. tamaño de una tarjeta de proyecto) ---
              const scale = 1.5; // Aumentado de 0.2 a 1.5
              clone.scale.set(scale, scale, scale);

              // --- CAMBIO CLAVE 2: DISPERSIÓN MUY AMPLIA (Ocupa todo el ancho de la pantalla) ---
              // El rango de -18 a 18 cubre sobradamente los bordes del navegador en una cámara con FOV 40
              const randomX = (Math.random() - 0.5) * 36; 
              const randomY = Math.random() * 12 - 2;
              const randomZ = Math.random() * 2 - 1; // Profundidad variada

              clone.position.set(randomX, randomY, randomZ);
              
              // Rotación inicial aleatoria para más dinamismo
              clone.rotation.set(Math.random()*Math.PI, Math.random()*Math.PI, Math.random()*Math.PI);

              clone.traverse((subChild) => {
                if ((subChild as THREE.Mesh).isMesh) {
                  const mesh = subChild as THREE.Mesh;
                  if (mesh.material) {
                    const materials = Array.isArray(mesh.material) ? mesh.material : [mesh.material];
                    materials.forEach((mat) => {
                      mat.transparent = true;
                      mat.opacity = 1.0;
                    });
                  }
                }
              });

              scene.add(clone);

              fallingItems.push({
                mesh: clone,
                speedY: 0.001 + Math.random() * 0.003, // Caída más lenta al ser objetos grandes
                rotX: 0.001 + Math.random() * 0.003, // Rotación suave
                rotY: 0.001 + Math.random() * 0.003,
                startX: randomX
              });
            }
          },
          undefined,
          (error) => { console.warn(`No se pudo cargar ${file}`, error); }
        );
      });

      // 3. BUCLE DE ANIMACIÓN Y SCROLL
      function animate() {
        requestAnimationFrame(animate);

        const scrollY = window.scrollY;
        const fadeHeight = window.innerHeight * 0.8;
        let scrollProgress = 1 - (scrollY / fadeHeight);
        scrollProgress = Math.max(0, Math.min(1, scrollProgress));

        // Animar cascada de iconos GRANDES
        fallingItems.forEach((item) => {
          item.mesh.position.y -= item.speedY;

          // Si una pieza sale por debajo, reaparece arriba a lo ancho
          if (item.mesh.position.y < -5) {
            item.mesh.position.y = 7 + Math.random() * 2;
            item.mesh.position.x = (Math.random() - 0.5) * 36; // Mantener dispersión amplia
          }

          // Rotación continua
          item.mesh.rotation.x += item.rotX;
          item.mesh.rotation.y += item.rotY;

          // Aplicar opacidad de scroll
          item.mesh.traverse((child) => {
            if ((child as THREE.Mesh).isMesh) {
              const mesh = child as THREE.Mesh;
              const mats = Array.isArray(mesh.material) ? mesh.material : [mesh.material];
              mats.forEach(mat => mat.opacity = scrollProgress);
            }
          });
        });

        // Opacidad del modelo principal
        if (holaModel) {
          holaModel.traverse((child) => {
            if ((child as THREE.Mesh).isMesh) {
              const mesh = child as THREE.Mesh;
              const mats = Array.isArray(mesh.material) ? mesh.material : [mesh.material];
              mats.forEach(mat => mat.opacity = scrollProgress);
            }
          });
        }

        renderer.render(scene, camera);
      }
      animate();

      window.addEventListener('resize', () => {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
      });
    </script>
  </body>
</html>